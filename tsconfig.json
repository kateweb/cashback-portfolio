{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["node_modules/@types"],  
    "types": ["node", "react"],  
    "skipLibCheck": true,  
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "app/api/offers.tsx", "components/Header.tsx", "components/DropdownMenu.js"],
  "exclude": ["node_modules"]
}
